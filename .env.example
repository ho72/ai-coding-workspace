HOST=127.0.0.1
PORT=4050
PUBLIC_ORIGIN=http://localhost:4050
LOG_LEVEL=info

DEVAI_SESSION_COOKIE=devai_session
DEVAI_SESSION_SECRET=
DEVAI_SESSION_TTL_SECONDS=43200
DEVAI_SESSION_MIN_IAT=0

UNIPASS_PUBLIC_ORIGIN=http://localhost:4000
UNIPASS_INTERNAL_ORIGIN=http://localhost:4000
DEVAI_ALLOWED_UNIPASS_IDS=
DEVAI_ALLOWED_UNIPASS_HANDLES=
DEVAI_ALLOWED_UNIPASS_EMAILS=

DEVAI_DATA_DIR=./data
DEVAI_HOME_DIR=.
DEVAI_DEFAULT_CWD=.
DEVAI_ALLOWED_CWD_ROOTS=.

DEVAI_MAX_REPLAY_BYTES=8388608
DEVAI_MAX_EVENTS_PER_REQUEST=5000
DEVAI_MAX_ATTACHMENT_BYTES=52428800
DEVAI_MAX_ATTACHMENTS_PER_TURN=8
DEVAI_MAX_ROOM_ATTACHMENT_BYTES=524288000
DEVAI_MAX_TOTAL_ATTACHMENT_BYTES=10737418240
DEVAI_TRASH_RETENTION_DAYS=7
DEVAI_ORPHAN_RETENTION_HOURS=24
DEVAI_ATTACHMENT_CLEANUP_INTERVAL_HOURS=24
DEVAI_ATTACHMENT_WARNING_PERCENT=70

DEVAI_CODEX_BIN=codex
DEVAI_CODEX_EXTRA_ARGS=[]
DEVAI_CLAUDE_BIN=claude
DEVAI_CLAUDE_EXTRA_ARGS=[]
DEVAI_CODEX_SETTINGS_CACHE_MS=30000
